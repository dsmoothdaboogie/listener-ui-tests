import { T, TEST_ID_ATTR } from './selectors';

const tid = (id: string) => `[${TEST_ID_ATTR}="${id}"]`;

describe("Open new deal", () => {
  it('replays the recorded flow', () => {
    cy.viewport(1280, 800);

    // On /deals
    cy.visit("/deals");
    cy.get(tid(T.dealSearch)).clear().type("Acme", { parseSpecialCharSequences: false });
    cy.get(tid(T.dealSearch)).type("{enter}");
    cy.get(tid(T.createDeal)).click();

    // On /deals/new
    cy.location('pathname').should('match', /\/deals\/new$/);
  });
});
