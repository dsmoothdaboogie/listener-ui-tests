// Requires use.testIdAttribute = "data-testid" in playwright.config.ts.
import { test, expect } from '@playwright/test';
import { T } from './selectors';

test("Open new deal", async ({ page }) => {
  // Recorded at 1280x800
  await test.step("On /deals", async () => {
    await page.goto("/deals");
    await page.getByTestId(T.dealSearch).fill("Acme");
    await page.getByTestId(T.dealSearch).press("Enter");
    await page.getByTestId(T.createDeal).click();
  });
  await test.step("On /deals/new", async () => {
    await expect(page).toHaveURL(/\/deals\/new(?:[?#]|$)/);
  });
});
